<h1><%= @ticket.subject %></h1>

<div id="ticket-status" data-ticket-status>
  <strong>Status:</strong>
  <span><%= @ticket.status %></span>
</div>

<p>
  <strong>Priority:</strong>
  <%= @ticket.priority %>
</p>

<p>
  <strong>Description:</strong>
  <%= @ticket.description %>
</p>

<% if @ticket.status != "resolved" %>
  <%= button_to "Resolve Ticket",
        resolve_ticket_path(@ticket),
        method: :patch %>
<% end %>

<% if @ticket.attachment.attached? %>
  <p>
    <%= link_to "View PDF Attachment",
                attachment_ticket_path(@ticket) %>
  </p>
<% end %>

<%= link_to "Back to Tickets", tickets_path %>